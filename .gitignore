# Secrets
.env
.env.*

# Node
scripts/node_modules/

# Obsidian workspace (changes every session, not meaningful to track)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/hotkeys.json

# Claude local settings
.claude/

# OS
Thumbs.db
.DS_Store

# Telegram session (stores auth credentials — never commit)
scripts/telegram.session
scripts/telegram.session-journal

# Pull history (machine-local runtime data)
scripts/.pull-history.jsonl
scripts/.regime-history.jsonl
scripts/.cache/

# Archived data pulls (relocated to World_Machine; kept on disk but not tracked/indexed)
05_Data_Pulls/_archive/

# Obsidian plugin session caches (large, machine-local, churns every session)
.obsidian/plugins/agent-client/sessions/
.obsidian/plugins/*/sessions/

# Qlib
.qlib_data/
scripts/qlib/
scripts/qlib/.venv/
scripts/qlib/__pycache__/
scripts/qlib/tests/__pycache__/
scripts/qlib/tests/tmp*/
