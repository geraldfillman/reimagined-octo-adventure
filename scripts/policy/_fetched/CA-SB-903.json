    "identifier":  "SB 903",
    "title":  "Mental health professionals: artificial intelligence.",
    "classification":  [
                           "bill"
                       ],
    "subject":  [
                    "Mentalhealthprofessionals",
                    "artificialintelligence"
                ],
    "extras":  {
